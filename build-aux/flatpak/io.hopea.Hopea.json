{
    "app-id": "io.hopea.Hopea",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "hopea",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-music",
        "--share=network",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=com.feralinteractive.GameMode",
        "--system-talk-name=org.freedesktop.hostname1",
        "--env=HOPEA_IMPORT_PYTHON=/app/lib/hopea/import-python/bin/python3",
        "--own-name=org.mpris.MediaPlayer2.io.hopea.Hopea"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_BUILD_JOBS": "4"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "import-dependencies",
            "buildsystem": "simple",
            "build-commands": [
                "python3 -m venv --without-pip /app/lib/hopea/import-python",
                "python3 -m pip --python /app/lib/hopea/import-python/bin/python3 install --no-cache-dir -r import-requirements.txt",
                "/app/lib/hopea/import-python/bin/python3 -I -c \"import vk_api, bs4, yandex_music, ytmusicapi, yt_dlp, Cryptodome, secretstorage, spotipy\""
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "../import-requirements.txt"
                },
                {
                    "type": "file",
                    "path": "../import-constraints.txt"
                }
            ]
        },
        {
            "name": "hopea",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=default",
                "-Dcargo-cache-dir=/run/ccache/hopea-gnome51"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        ".git",
                        "_builddir",
                        "_flatpak",
                        ".flatpak-builder",
                        "dist",
                        "result",
                        "node/target",
                        "common/target",
                        "src/config.rs",
                        "target",
                        "spotify/target",
                        ".venv-import",
                        "__pycache__",
                        ".codex",
                        ".agents",
                        ".aws",
                        ".env",
                        "_windows",
                        "_android"
                    ]
                }
            ]
        }
    ],
    "separate-locales": false
}
