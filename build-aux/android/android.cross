[binaries]
rust = ['rustc', '--target=' + arch + '-linux-android']
rust_ld = toolchain / 'bin' / (arch + '-linux-android31-clang')

[gstreamer-full:project options]
tests = 'disabled'
examples = 'disabled'
introspection = 'disabled'
libav = 'disabled'
ges = 'disabled'
devtools = 'disabled'
rtsp_server = 'disabled'
gst-examples = 'disabled'
python = 'disabled'
libnice = 'disabled'
qt5 = 'disabled'
qt6 = 'disabled'

[libsoup:project options]
introspection = 'disabled'
vapi = 'disabled'
tests = false
sysprof = 'disabled'
docs = 'disabled'
