+#pragma once
+#include <jni.h>
+#include <android/input.h>
+
+/* Hopea: Java input events are available before Android 12's fromJava NDK
+ * bridges. Borrow the event only for the synchronous GTK-thread dispatch;
+ * never retain a JNI local reference beyond that call. */
+typedef struct { JNIEnv *env; jobject object; } HopeaInputEvent;
+static inline jmethodID
+hopea_input_method (const HopeaInputEvent *event, const char *name, const char *signature)
+{
+  jclass klass = (*event->env)->GetObjectClass (event->env, event->object);
+  jmethodID method = (*event->env)->GetMethodID (event->env, klass, name, signature);
+  (*event->env)->DeleteLocalRef (event->env, klass);
+  return method;
+}
+static inline jint
+hopea_AInputEvent_getSource (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getSource", "()I"));
+}
+static inline jint
+hopea_AInputEvent_getDeviceId (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getDeviceId", "()I"));
+}
+static inline jint
+hopea_AMotionEvent_getAction (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getAction", "()I"));
+}
+static inline jint
+hopea_AMotionEvent_getMetaState (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getMetaState", "()I"));
+}
+static inline jint
+hopea_AMotionEvent_getPointerCount (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getPointerCount", "()I"));
+}
+static inline jint
+hopea_AMotionEvent_getButtonState (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getButtonState", "()I"));
+}
+static inline jint
+hopea_AKeyEvent_getAction (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getAction", "()I"));
+}
+static inline jint
+hopea_AKeyEvent_getMetaState (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getMetaState", "()I"));
+}
+static inline jint
+hopea_AKeyEvent_getKeyCode (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getKeyCode", "()I"));
+}
+static inline jlong
+hopea_AMotionEvent_getEventTime (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallLongMethod (event->env, event->object,
+      hopea_input_method (event, "getEventTime", "()J")) * 1000000;
+}
+static inline jlong
+hopea_AMotionEvent_getDownTime (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallLongMethod (event->env, event->object,
+      hopea_input_method (event, "getDownTime", "()J")) * 1000000;
+}
+static inline jlong
+hopea_AKeyEvent_getEventTime (const HopeaInputEvent *event)
+{
+  return (*event->env)->CallLongMethod (event->env, event->object,
+      hopea_input_method (event, "getEventTime", "()J")) * 1000000;
+}
+static inline jint
+hopea_AMotionEvent_getToolType (const HopeaInputEvent *event, size_t index)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getToolType", "(I)I"), (jint)index);
+}
+static inline jint
+hopea_AMotionEvent_getPointerId (const HopeaInputEvent *event, size_t index)
+{
+  return (*event->env)->CallIntMethod (event->env, event->object,
+      hopea_input_method (event, "getPointerId", "(I)I"), (jint)index);
+}
+static inline jfloat
+hopea_AMotionEvent_getX (const HopeaInputEvent *event, size_t index)
+{
+  return (*event->env)->CallFloatMethod (event->env, event->object,
+      hopea_input_method (event, "getX", "(I)F"), (jint)index);
+}
+static inline jfloat
+hopea_AMotionEvent_getY (const HopeaInputEvent *event, size_t index)
+{
+  return (*event->env)->CallFloatMethod (event->env, event->object,
+      hopea_input_method (event, "getY", "(I)F"), (jint)index);
+}
+static inline jfloat
+hopea_AMotionEvent_getAxisValue (const HopeaInputEvent *event, int axis, size_t index)
+{
+  return (*event->env)->CallFloatMethod (event->env, event->object,
+      hopea_input_method (event, "getAxisValue", "(II)F"), (jint)axis, (jint)index);
+}
