+	// Hopea: move legacy user files before GTK refreshes its asset directory.
+	private void hopeaPreserveUserFiles(java.io.File home) throws java.io.IOException {
+		String[] assets = getAssets().list("");
+		java.io.File[] files = getFilesDir().listFiles();
+		if (assets == null || files == null)
+			throw new java.io.IOException("Unable to list legacy data or runtime assets");
+		java.util.Set<String> resources = new java.util.HashSet<>(java.util.Arrays.asList(assets));
+		resources.add("afpr");
+		for (java.io.File file : files) {
+			if (resources.contains(file.getName()))
+				continue;
+			java.io.File target = new java.io.File(home, file.getName());
+			// Never overwrite an existing directory or continue to the asset
+			// cleanup after a failed migration. Both copies remain recoverable.
+			if (target.exists() || !file.renameTo(target))
+				throw new java.io.IOException("Unable to preserve legacy user data");
+		}
+	}
