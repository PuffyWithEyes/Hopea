using Gtk 4.0;
using Adw 1;

template $HopeaPlaylistView: Widget {
  Adw.NavigationView navigation {
    Adw.NavigationPage playlist_page {
      tag: "playlist";
      title: _("Playlist");
      child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      ToggleButton search_button {
        icon-name: "hopea-system-search-symbolic";
        action-name: "queue.search";
        valign: center;
        tooltip-text: _("Search Songs in the Playlist");
      }

      title-widget: Box queue_length_box {
        orientation: vertical;
        valign: center;

        Label {
          ellipsize: end;
          label: _("Playlist");

          styles [
            "heading",
          ]
        }

        Label queue_length_label {
          ellipsize: end;

          styles [
            "caption",
          ]
        }
      };

      [end]
      Button back_button {
        visible: false;
        icon-name: "hopea-go-previous-symbolic";
        action-name: "queue.toggle";
        valign: center;
        tooltip-text: _("Close the Playlist");
      }

      [end]
      ToggleButton select_button {
        icon-name: "hopea-selection-mode-symbolic";
        action-name: "queue.select";
        valign: center;
        tooltip-text: _("Select Songs in the Playlist");
      }
    }

    [top]
    Box albums_section {
      orientation: vertical;
      spacing: 6;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 6;

      Box {
        spacing: 6;
        Label {
          label: _("Albums");
          xalign: 0;
          hexpand: true;
          styles [ "heading" ]
        }
        Button new_album_button {
          label: _("New Album");
          styles [ "flat" ]
        }
        Button open_album_button {
          icon-name: "hopea-document-open-symbolic";
          tooltip-text: _("Open a shared Hopea album");
          styles [ "flat" ]
        }
      }

      ScrolledWindow albums_scroll {
        visible: false;
        hscrollbar-policy: automatic;
        vscrollbar-policy: never;
        min-content-height: 192;
        max-content-height: 208;
        propagate-natural-height: true;
        overlay-scrolling: false;
        child: ListView albums_list {
          orientation: horizontal;
          single-click-activate: true;
          styles [ "background", "album-results" ]
        };
      }
    }

    [top]
    SearchBar playlist_searchbar {
      child: SearchEntry playlist_searchentry {
        placeholder-text: _("Search songs");
        hexpand: true;

        accessibility {
          label: C_("a11y", "Search");
          description: C_("a11y", "Type to search songs");
        }
      };
    }

    content: Overlay playlist_overlay {
      [overlay]
      ProgressBar playlist_progress {
        valign: start;
        hexpand: true;
        visible: false;

        styles [
          "osd",
        ]
      }

      ScrolledWindow playlist_scroll {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;
        vexpand: true;

        child: ListView queue_view {
          single-click-activate: true;

          styles [
            "navigation-sidebar",
          ]
        };
      }
    };

    [bottom]
    ActionBar queue_actionbar {
      revealed: false;

      styles [
        "flat",
      ]

      Button queue_select_all_button {
        icon-name: "hopea-edit-select-all-symbolic";
        tooltip-text: _("Select All Songs");
      }

      [center]
      Label queue_selected_label {
        styles [
          "caption",
        ]
      }

      [end]
      Button queue_remove_button {
        icon-name: "hopea-app-remove-symbolic";
        tooltip-text: _("Remove Selected Songs");
      }
    }

    styles [
      "playlist-background",
    ]
  };
    }
  }
}
