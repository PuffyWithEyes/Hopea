using Gtk 4.0;
using Adw 1;
// The shared music side panel, at the right of the main window
template $HopeaLibraryPanel: Adw.Bin {
  width-request: 320;

  child: Adw.ToastOverlay toast_overlay {
    child: Box {
      orientation: vertical;

      Adw.Banner vpn_banner {
        title: _("VPN is not active. Turn on your VPN or turn off “Share Only Through a VPN” in Settings.");
        button-label: _("Settings");
        revealed: false;
      }

      Adw.NavigationView navigation {
        vexpand: true;

        Adw.NavigationPage {
          tag: "main";
          title: _("Shared Music");

          child: Adw.ToolbarView {
            [top]
            // No window buttons on the panel: a close button there reads
            // as closing the panel, and would quit the app instead
            Adw.HeaderBar {
              show-start-title-buttons: false;
              show-end-title-buttons: false;

              [start]
              Button my_music_button {
                icon-name: "hopea-folder-music-symbolic";
                tooltip-text: _("My Music");
                action-name: "win.show-my-music";
                visible: false;
              }

              title-widget: Box {
                Label title_label {
                  label: _("Shared Music");

                  styles [
                    "title",
                  ]
                }

                Adw.ViewSwitcher switcher {
                  stack: view_stack;
                  policy: narrow;
                  visible: false;
                }
              };

              [end]
              Button close_library_button {
                icon-name: "hopea-sidebar-show-right-symbolic";
                tooltip-text: _("Hide Shared Music");
                action-name: "win.shared-library";
              }

              [end]
              MenuButton menu_button {
                icon-name: "hopea-open-menu-symbolic";
                tooltip-text: _("Library Menu");
                menu-model: library_menu;
                visible: false;
              }
            }

            content: Stack stack {
              transition-type: crossfade;

              StackPage {
                name: "welcome";

                child: ScrolledWindow {
                  hscrollbar-policy: never;
                  child: Adw.Clamp {
                    maximum-size: 400;
                    tightening-threshold: 300;
                    child: Box {
                      orientation: vertical;
                      valign: center;
                      spacing: 18;
                      margin-start: 20;
                      margin-end: 20;
                      margin-top: 24;
                      margin-bottom: 24;
                      Image {
                        icon-name: "hopea-network-workgroup-symbolic";
                        pixel-size: 48;
                        halign: center;
                        styles [ "accent" ]
                      }
                      Label {
                        label: _("Your Music, Shared");
                        wrap: true;
                        wrap-mode: word_char;
                        justify: center;
                        styles [ "title-1" ]
                      }
                      Label {
                        label: _("Discover songs from other listeners and share your favorites.");
                        wrap: true;
                        wrap-mode: word_char;
                        justify: center;
                        styles [ "dim-label" ]
                      }
                      Box {
                        orientation: vertical;
                        spacing: 10;
                        styles [ "card", "sharing-connection" ]
                        Box {
                          spacing: 8;
                          Image connection_icon { icon-name: "hopea-network-workgroup-symbolic"; }
                          Label connection_title {
                            label: _("Ready to Connect");
                            xalign: 0;
                            wrap: true;
                            hexpand: true;
                            styles [ "heading" ]
                          }
                        }
                        Label connection_description {
                          xalign: 0;
                          wrap: true;
                          wrap-mode: word_char;
                          styles [ "dim-label" ]
                        }
                        Button connection_settings {
                          label: _("Connection Settings");
                          halign: start;
                          styles [ "flat" ]
                        }
                      }
                      Adw.PreferencesGroup {
                        Adw.EntryRow name_row {
                          title: _("Your Name (Optional)");
                        }
                      }
                      Label {
                        label: _("Shown next to the music you share.");
                        xalign: 0;
                        wrap: true;
                        styles [ "caption", "dim-label" ]
                      }
                      Button join_button {
                        label: _("_Join the Network");
                        use-underline: true;

                        styles [
                          "suggested-action",
                          "pill",
                        ]
                      }

                      // Music from streaming services, looked for once joined
                      Button {
                        label: _("_Import Music…");
                        use-underline: true;
                        action-name: "library.import";

                        styles [
                          "pill",
                        ]
                      }
                      Label {
                        label: _("Share only music you have permission to share.");
                        wrap: true;
                        wrap-mode: word_char;
                        justify: center;
                        styles [ "caption", "dim-label" ]
                      }
                    };
                  };
                };
              }

              StackPage {
                name: "loading";

                child: Adw.Spinner {
                  halign: center;
                  valign: center;
                  width-request: 32;
                  height-request: 32;
                };
              }

              StackPage {
                name: "library";

                child: Box {
                  orientation: vertical;

                  Adw.ViewStack view_stack {
                    vexpand: true;

                    Adw.ViewStackPage {
                      name: "search";
                      title: _("Search");
                      icon-name: "hopea-system-search-symbolic";

                      child: Box {
                        orientation: vertical;

                        Adw.Clamp {
                          maximum-size: 560;
                          child: Box reach_status {
                            orientation: vertical;
                            spacing: 4;
                            margin-start: 12;
                            margin-end: 12;
                            margin-top: 8;
                            margin-bottom: 4;

                            Box {
                              spacing: 8;
                              Box reach_indicator {
                                spacing: 6;
                                hexpand: true;
                                Label { label: "●"; }
                                Label reach_title {
                                  label: _("Checking Connection…");
                                  xalign: 0;
                                  hexpand: true;
                                  ellipsize: end;
                                  styles [ "heading" ]
                                }
                              }
                              Button reach_details {
                                label: _("Details");
                                valign: center;
                                styles [ "flat", "caption" ]
                              }
                            }
                          };
                        }

                        Adw.Clamp {
                          maximum-size: 560;

                          child: Box {
                            spacing: 6;
                            margin-start: 12;
                            margin-end: 12;
                            margin-top: 6;
                            margin-bottom: 6;

                            SearchEntry search_entry {
                              placeholder-text: _("Search songs, artists and albums");
                              search-delay: 300;
                              hexpand: true;
                            }

                            DropDown order_dropdown {
                              tooltip-text: _("Order of the Songs Found");
                              model: StringList {
                                strings [
                                  _("Best Match"),
                                  _("Most Shared"),
                                ]
                              };
                            }
                          };
                        }

                        Stack search_stack {
                          transition-type: crossfade;
                          vexpand: true;

                          StackPage {
                            name: "results";

                            child: Box {
                              orientation: vertical;
                              Box albums_section {
                                orientation: vertical;
                                visible: false;
                                spacing: 6;
                                Label {
                                  label: _("Albums");
                                  xalign: 0;
                                  margin-start: 12;
                                  styles [ "heading" ]
                                }
                                ScrolledWindow albums_scroll {
                                  hscrollbar-policy: automatic;
                                  vscrollbar-policy: never;
                                  min-content-height: 208;
                                  propagate-natural-height: true;
                                  overlay-scrolling: false;
                                  child: ListView albums_list {
                                    orientation: horizontal;
                                    single-click-activate: true;
                                    styles [ "background", "album-results" ]
                                  };
                                }
                                Label {
                                  label: _("Songs");
                                  xalign: 0;
                                  margin-start: 12;
                                  styles [ "heading" ]
                                }
                              }
                              ScrolledWindow results_scroll {
                                vexpand: true;
                                hscrollbar-policy: never;
                                child: ListView results_list {
                                  styles [ "background" ]
                                };
                              }
                              Box network_status {
                                spacing: 8;
                                halign: center;
                                visible: false;
                                Adw.Spinner {}
                                Label {
                                  label: _("Searching other people’s music…");
                                  styles [ "dim-label" ]
                                }
                              }
                              Adw.Spinner page_spinner {
                                visible: false;
                                halign: center;
                                height-request: 24;
                                margin-top: 6;
                                margin-bottom: 6;
                              }
                              Button retry_page_button {
                                label: _("Retry");
                                halign: center;
                                visible: false;
                                margin-bottom: 6;
                              }
                            };
                          }

                          StackPage {
                            name: "empty";

                            child: Adw.StatusPage empty_page {
                              icon-name: "hopea-folder-music-symbolic";
                              title: _("No Songs Found");
                            };
                          }
                        }
                      };
                    }

                  }
                };
              }
            };

            [bottom]
            Box upload_bar {
              visible: false;
              spacing: 6;
              homogeneous: true;
              margin-start: 12;
              margin-end: 12;
              margin-top: 6;
              margin-bottom: 12;

              Button upload_button {
                action-name: "library.upload";
                tooltip-text: _("Choose music files on this device to share with everyone");

                child: Adw.ButtonContent {
                  icon-name: "hopea-list-add-symbolic";
                  label: _("_Share Songs…");
                  use-underline: true;
                  can-shrink: true;
                };

                styles [
                  "suggested-action",
                  "pill",
                ]
              }

              Button {
                action-name: "library.upload-folder";
                tooltip-text: _("Choose a folder, such as an album, and share every song in it");

                child: Adw.ButtonContent {
                  icon-name: "hopea-folder-music-symbolic";
                  label: _("Share _Album…");
                  use-underline: true;
                  can-shrink: true;
                };

                styles [
                  "suggested-action",
                  "pill",
                ]
              }
            }
          };
        }

        Adw.NavigationPage album_page {
          tag: "album";
          title: _("Album");

          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              show-start-title-buttons: false;
              show-end-title-buttons: false;
            }

            content: Stack album_stack {
              transition-type: crossfade;

              StackPage {
                name: "loading";

                child: Box {
                  orientation: vertical;
                  spacing: 12;
                  halign: center;
                  valign: center;

                  Adw.Spinner {
                    width-request: 32;
                    height-request: 32;
                  }

                  Label {
                    label: _("Looking for the album’s songs…");

                    styles [
                      "dim-label",
                    ]
                  }
                };
              }

              StackPage {
                name: "results";

                child: ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Adw.Clamp {
                    maximum-size: 560;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;
                      margin-start: 12;
                      margin-end: 12;
                      margin-top: 12;
                      margin-bottom: 12;

                      Label album_title {
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;

                        styles [
                          "title-2",
                        ]
                      }

                      Label album_subtitle {
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;

                        styles [
                          "dim-label",
                        ]
                      }

                      Box {
                        spacing: 6;
                        homogeneous: true;

                        Button {
                          action-name: "library.play-album";

                          child: Adw.ButtonContent {
                            icon-name: "hopea-media-playback-start-symbolic";
                            label: _("_Play Album");
                            use-underline: true;
                          };

                          styles [
                            "suggested-action",
                            "pill",
                          ]
                        }

                        Button {
                          action-name: "library.download-album";
                          tooltip-text: _("Download every song, check it, and save it to a folder of your choice");

                          child: Adw.ButtonContent {
                            icon-name: "hopea-folder-download-symbolic";
                            label: _("_Download…");
                            use-underline: true;
                          };

                          styles [
                            "pill",
                          ]
                        }
                      }

                      ListBox album_list {
                        selection-mode: none;

                        styles [
                          "boxed-list",
                        ]
                      }
                    };
                  };
                };
              }

              StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "hopea-media-optical-symbolic";
                  title: _("No Songs Found");
                  description: _("Nobody who has this album is online right now");
                };
              }
            };
          };
        }
      }

      Revealer upload_revealer {
        transition-type: slide_up;

        child: Box {
          orientation: vertical;
          spacing: 6;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 12;

          Label upload_label {
            xalign: 0;
            ellipsize: middle;
          }

          ProgressBar upload_progress {}
        };
      }
    };
  };
}

menu library_menu {
  section {
    item {
      label: _("_Bring Your Music Over…");
      action: "library.import";
    }

    item {
      label: _("_Settings…");
      action: "library.settings";
    }
  }

  section {
    item {
      label: _("_Leave the Network");
      action: "library.leave";
    }
  }
}
