using Gtk 4.0;

template $HopeaPlaybackControl: Widget {
  Box center_box {
    orientation: vertical;
    spacing: 6;
    width-request: 256;

    Box controls_box {
      spacing: 24;
      halign: center;
      hexpand: true;

      Button previous_button {
        icon-name: "hopea-media-skip-backward-symbolic";
        action-name: "win.previous";
        valign: center;
        tooltip-text: _("Play the Previous Song");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip backwards");
        }
      }

      Button play_button {
        icon-name: "hopea-media-playback-start-symbolic";
        action-name: "win.play";
        valign: center;
        tooltip-text: _("Toggle Play");

        styles [
          "circular",
          "large",
        ]

        accessibility {
          label: C_("a11y", "Toggle play");
        }
      }

      Button next_button {
        icon-name: "hopea-media-skip-forward-symbolic";
        action-name: "win.next";
        valign: center;
        tooltip-text: _("Play the Next Song");

        styles [
          "circular",
        ]

        accessibility {
          label: C_("a11y", "Skip forward");
        }
      }
    }

    $HopeaVolumeControl volume_control {
      hexpand: "true";
    }

    CenterBox {
      [start]
      Box start_box {
        halign: start;
        spacing: 12;
        margin-end: 18;

        ToggleButton playlist_button {
          icon-name: "hopea-view-queue-symbolic";
          action-name: "queue.toggle";
          valign: center;
          tooltip-text: _("Toggle Playlist");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Toggle playlist");
          }
        }

        ToggleButton shuffle_button {
          icon-name: "hopea-media-playlist-shuffle-symbolic";
          action-name: "queue.shuffle";
          valign: center;
          tooltip-text: _("Shuffle the Playlist");

          accessibility {
            label: C_("a11y", "Shuffle");
          }

          styles [
            "circular",
          ]
        }
      }

      [end]
      Box end_box {
        halign: end;
        spacing: 12;
        margin-start: 18;
        // Shows the lyrics in place of the cover art
        ToggleButton lyrics_button {
          icon-name: "hopea-media-view-subtitles-symbolic";
          action-name: "win.lyrics";
          valign: center;
          tooltip-text: _("Lyrics");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Lyrics");
          }
        }

        // Puts the song playing in the library, or takes it out
        Button favorite_button {
          icon-name: "hopea-non-starred-symbolic";
          action-name: "win.toggle-favorite";
          valign: center;
          sensitive: false;
          tooltip-text: _("Keep and Share");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Favorite");
          }
        }

        Button repeat_button {
          icon-name: "hopea-media-playlist-consecutive-symbolic";
          action-name: "queue.repeat-mode";
          valign: center;
          tooltip-text: _("Enable Repeat");

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Repeat");
          }
        }

        MenuButton menu_button {
          menu-model: primary_menu;
          icon-name: "hopea-open-menu-symbolic";
          primary: true;
          halign: end;
          valign: center;
          tooltip-text: _("Main Menu");
          direction: up;

          styles [
            "circular",
          ]

          accessibility {
            label: C_("a11y", "Primary menu");
          }
        }
      }
    }
  }
}

menu primary_menu {
  section {
    item { label: _("Change Cover…"); action: "win.edit-cover"; }
    item { label: _("Edit Lyrics…"); action: "win.edit-lyrics"; }
    item { label: _("Choose Cover and Lyrics…"); action: "win.metadata"; }
  }
  section {
    item {
      label: _("Copy");
      action: "win.copy";
    }

    item {
      label: _("Open Directory");
      action: "win.open-directory";
      hidden-when: "action-missing";
    }
  }

  section {
    item {
      label: _("_Match Cover Art");
      action: "win.enable-recoloring";
    }

    item {
      label: _("_Background Playback");
      action: "app.background-play";
    }
  }

  section {
    submenu {
      label: _("_ReplayGain");

      item {
        label: C_("replaygain-menu", "_Album");
        action: "win.replaygain";
        target: "album";
      }

      item {
        label: C_("replaygain-menu", "_Song");
        action: "win.replaygain";
        target: "track";
      }

      item {
        label: C_("replaygain-menu", "_Disabled");
        action: "win.replaygain";
        target: "off";
      }
    }
  }

}
