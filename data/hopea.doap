<Project xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">

  <name xml:lang="en">Hopea</name>
  <shortdesc xml:lang="en">Play, import and share music</shortdesc>
  <homepage rdf:resource="https://github.com/PuffyWithEyes/Hopea"/>
  <bug-database rdf:resource="https://github.com/PuffyWithEyes/Hopea/issues"/>
  <repository>
    <GitRepository>
      <location rdf:resource="https://github.com/PuffyWithEyes/Hopea.git"/>
      <browse rdf:resource="https://github.com/PuffyWithEyes/Hopea"/>
    </GitRepository>
  </repository>

  <programming-language>Rust</programming-language>
  <platform>GTK 4</platform>
  <platform>Libadwaita</platform>

<maintainer><foaf:Person><foaf:name>Daniil Klimov</foaf:name></foaf:Person></maintainer>
</Project>
